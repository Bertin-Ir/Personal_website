---
// Companies the user is currently building outside coursework and independent projects.
// Qualitative only — no metrics until the user supplies verified figures.
interface Venture {
  name: string;
  tagline: string;
  role: string;
  description: string;
  liveUrl: string;
}

const ventures: Venture[] = [
  {
    name: 'Marsa',
    tagline: 'Digital Marketing and Business Technology Consulting Company',
    role: 'Co-Founder',
    description:
      'Marsa combines performance marketing with real software engineering — SEO, paid media, web/app development, and AI integration for businesses.',
    liveUrl: 'https://marsha-digital.vercel.app/',
  },
];
---

<section class="px-4 sm:px-6 py-12 md:py-16" aria-label="Ventures">
  <div class="max-w-4xl mx-auto w-full min-w-0">
    <h1 class="text-2xl md:text-3xl font-bold text-[var(--ink)] mb-8">Companies I'm building</h1>

    <div class="grid gap-6">
      {ventures.map((venture) => (
        <div class="venture-card relative rounded-2xl border border-[var(--accent)]/30 bg-[var(--accent-muted)]/10 p-6 md:p-8">
          <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
            <div>
              <div class="flex items-center gap-3 flex-wrap">
                <h2 class="text-xl md:text-2xl font-bold text-[var(--accent)]">{venture.name}</h2>
                <span class="live-badge inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-[var(--accent)]/15 text-[var(--accent)] border border-[var(--accent)]/30">
                  <span class="live-dot w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
                  Live
                </span>
              </div>
              <p class="text-sm text-[var(--ink)]/70 italic mt-1">{venture.tagline}</p>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wide text-[var(--ink)]/50 shrink-0">
              {venture.role}
            </span>
          </div>

          <p class="text-sm md:text-base text-[var(--ink)]/85 leading-relaxed mt-4 max-w-2xl">
            {venture.description}
          </p>

          <a
            href={venture.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 mt-6 px-5 py-2.5 border border-[var(--accent)]/50 text-[var(--accent)] font-medium text-sm rounded-lg hover:bg-[var(--accent-muted)] transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--surface)]"
            aria-label={`Visit ${venture.name} (opens in a new tab)`}
          >
            Visit {venture.name}
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .live-dot {
    animation: live-dot-pulse 2s ease-in-out infinite;
  }
  @keyframes live-dot-pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot {
      animation: none;
    }
  }
</style>
